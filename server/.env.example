# Server port
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/moi-management

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# JWT lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Allowed browser origin(s), comma-separated. Vite dev server by default.
# In production set this to your Vercel URL, e.g. https://moi.vercel.app
CLIENT_URL=http://localhost:5173

# Cookie SameSite policy. Keep "lax" when the API and SPA share a site.
# Set to "none" when the SPA (Vercel) and API (Render/Railway) are on
# different domains — this also forces the Secure flag (HTTPS only).
COOKIE_SAME_SITE=lax
